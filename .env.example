# Spring profile and common runtime defaults
SPRING_PROFILES_ACTIVE=dev
TZ=UTC

# Local service ports
API_GATEWAY_PORT=8080
PAYMENT_SERVICE_PORT=8081
LEDGER_SERVICE_PORT=8082
FRAUD_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084

# Local dependency endpoints; never commit real credentials.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=payment_platform
POSTGRES_USER=payment
POSTGRES_PASSWORD=payment
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
