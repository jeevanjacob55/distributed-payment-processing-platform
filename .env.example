# Spring profile and common runtime defaults
SPRING_PROFILES_ACTIVE=dev
TZ=UTC

# Local service ports
API_GATEWAY_PORT=8080
PAYMENT_SERVICE_PORT=8081
LEDGER_SERVICE_PORT=8082
FRAUD_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084

# Gateway routing and OIDC resource-server validation.
PAYMENT_SERVICE_URL=http://localhost:8081
LEDGER_SERVICE_URL=http://localhost:8082
FRAUD_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8084
JWT_ISSUER_URI=http://localhost:9000
JWT_JWK_SET_URI=http://localhost:9000/oauth2/jwks

# Local dependency endpoints; never commit real credentials.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=payment_platform
POSTGRES_USER=payment
POSTGRES_PASSWORD=payment
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
